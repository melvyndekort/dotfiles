{{- $email := promptStringOnce . "email" "What is your e-mail address" -}}
{{- $laptop := promptBoolOnce . "laptop" "Is this a laptop (y/n)" -}}
{{- $work := promptBoolOnce . "work" "Do you use this device for work (y/n)" -}}

encryption = "gpg"

[gpg]
  recipient = "melvyn@mdekort.nl"

[data]
  laptop = {{ $laptop }}
  work = {{ $work }}
  email = "{{ $email }}"
